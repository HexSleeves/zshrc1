#!/usr/bin/env zsh
# z1 test runner.
#
# usage: tests/run [file...]
#   (no args)  every file in tests/bats
#   file...    only those files
#
# BATS_JOBS controls bats concurrency (default 4).
# BATS_TEST_TIMEOUT caps a single test in seconds (default 30).

0=${(%):-%x}
setopt extended_glob

local prjdir=${0:A:h:h}
cd $prjdir || exit 1

local dep
for dep in bats parallel; do
  (( $+commands[$dep] )) || {
    print -ru2 "tests/run: fatal: required command '$dep' not found."
    exit 127
  }
done

# bats --jobs shells out to GNU parallel. Point its state at a scratch dir so
# it never writes to the user's $HOME, and pre-answer the citation notice that
# older versions print on first run.
export PARALLEL_HOME="${TMPDIR:-/tmp}/z1-tests-parallel"
mkdir -p "$PARALLEL_HOME" && : >> "$PARALLEL_HOME/will-cite"

# A wedged test should fail, not hang the suite. bats needs the `timeout`
# binary for this, so only ask for it when one is around.
if (( $+commands[timeout] || $+commands[gtimeout] )); then
  export BATS_TEST_TIMEOUT=${BATS_TEST_TIMEOUT:-30}
fi

local -a testfiles=($@)
(( $#testfiles )) || testfiles=($prjdir/tests/bats/*.bats(N))

(( $#testfiles )) || {
  print -ru2 "tests/run: no test files found"
  exit 1
}

exec bats --jobs ${BATS_JOBS:-4} $testfiles
